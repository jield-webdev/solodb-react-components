{
  "name": "@jield/solodb-react-components",
  "version": "1.2.5",
  "type": "module",
  "repository": "jield-webdev/solodb-react-components",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "cd example && yarn dev",
    "example:install": "cd example && yarn install",
    "release": "bash scripts/release.sh",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jield/solodb-typescript-core": "^1.2.5",
    "@testing-library/dom": "^10.4.1",
    "dompurify": "^3.4.12",
    "qrcode.react": "^4.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dropzone": "^15.0.0",
    "react-google-charts": "^5.2.1",
    "react-hook-form": "^7.81.0",
    "react-intersection-observer": "^10.1.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "yet-another-react-lightbox": "^3.32.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90",
    "@tanstack/react-table": "^8.21",
    "axios": "^1.13.2",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.9"
  },
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axios": "^1.18.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.17.1"
}
