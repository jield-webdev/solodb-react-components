{
  "name": "@jield/solodb-react-components",
  "version": "1.3.2",
  "type": "module",
  "repository": "jield-webdev/solodb-react-components",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/solodb-react-components.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "cd example && yarn dev",
    "example:install": "cd example && yarn install",
    "release": "bash scripts/release.sh",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jield/solodb-typescript-core": "^1.2.7",
    "@testing-library/dom": "^10.4.2",
    "dompurify": "^3.4.17",
    "qrcode.react": "^4.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dropzone": "^20.1.4",
    "react-google-charts": "^5.2.1",
    "react-hook-form": "^7.90.0",
    "react-intersection-observer": "^11.0.1",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90",
    "@tanstack/react-table": "^8.21",
    "axios": "^1.13.2",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.9"
  },
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axios": "^1.20.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.18.1"
}
